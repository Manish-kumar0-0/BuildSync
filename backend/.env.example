APP_NAME=BuildSync Backend
API_VERSION=1.0.0
ENVIRONMENT=development
DEMO_PASSWORD=<set-only-for-development-or-staging>
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
JWT_SECRET_KEY=<generate-a-random-secret-at-least-32-bytes>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
AI_PROVIDER=gemini
GEMINI_API_KEY=<set-in-environment-only>
GEMINI_VISION_MODEL=gemini-2.5-flash
WEATHER_PROVIDER=
WEATHER_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=25000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
PASSWORD_RESET_EXPIRE_MINUTES=10
# Relative to the backend working directory. Replace with a compatible
# construction-trained Ultralytics model when one is available.
YOLO_MODEL_PATH=models/yolo11n.pt
YOLO_CLASSES=
FUSION_HIGH_CONFIDENCE_THRESHOLD=80
FUSION_MEDIUM_CONFIDENCE_THRESHOLD=60
FUSION_HIGH_REPORTED_WEIGHT=0.4
FUSION_HIGH_AI_WEIGHT=0.6
FUSION_MEDIUM_REPORTED_WEIGHT=0.6
FUSION_MEDIUM_AI_WEIGHT=0.4
MINOR_VARIANCE_THRESHOLD=-5
SIGNIFICANT_VARIANCE_THRESHOLD=-15
RISK_LOW_MAX_SCORE=24
RISK_MEDIUM_MAX_SCORE=49
RISK_HIGH_MAX_SCORE=74
